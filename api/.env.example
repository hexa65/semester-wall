# Copy this file to .env and fill it in. Never commit .env.
# Neon: use the POOLED connection string here (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# The website address that may call this API. Exact match: https, no trailing slash.
# Several addresses can be separated with commas.
CORS_ORIGIN=http://localhost:5173
# Set to true for a public demo: every request except GET is refused with 403.
READ_ONLY=false
PORT=4000
# Secret that signs login tokens. Random text, at least 32 characters. Keep it private.
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-text-of-at-least-32-characters
